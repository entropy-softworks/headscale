# operations
append emails [{"value":"home@example.com","type":"home"}]
set emails[type eq "home"].primary true
remove emails[type eq "work"]
set name.formatted "Barbara J Jensen"
ignore name.middleName (not stored)
set userName "bjensen"
remove name.formatted
remove displayName
# result
