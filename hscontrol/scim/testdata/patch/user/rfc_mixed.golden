  "externalId": "ext-7",
  "userName": "bjensen",
  "name": {
    "familyName": "Name",
    "givenName": "Old"
  },
  "active": true,
  "emails": [
    {
      "value": "home@example.com",
      "type": "home",
      "primary": true
    }
  ],
  "meta": {
    "resourceType": "User",
    "created": "1970-01-01T00:00:00Z"
  }
}
